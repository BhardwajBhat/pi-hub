# ~/.config/systemd/user/pi-hub.service
[Unit]
Description=pi hub: chat with Pi on all your machines
After=network-online.target

[Service]
Environment=PIHUB_BIND=127.0.0.1
Environment=PIHUB_PORT=8377
# Your laptops' ssh host names (Tailscale names), space separated.
Environment="PIHUB_MACHINES=laptop-a laptop-b"
Environment=PATH=%h/.pi/agent/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pi-hub/pi-hub.py
Restart=on-failure

[Install]
WantedBy=default.target
